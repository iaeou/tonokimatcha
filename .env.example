# Copy to .env for local development, and set the same names in Vercel
# (Project → Settings → Environment Variables). None of these may be prefixed
# with PUBLIC_: SvelteKit ships PUBLIC_ variables to the browser.

# --- Supabase: where /request writes. Required. ---------------------------
# Project → Settings → API. The service-role key bypasses RLS — server only.
SUPABASE_URL="https://yytzsqvphsdjlwlgkapl.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
# Optional, defaults to "requests".
# SUPABASE_REQUESTS_TABLE="requests"

# --- Email notification: optional, and live in production. ----------------
# Without these the form still works; the request simply lands in the table
# without ringing anyone. NOTIFY_TO may be a comma-separated list.
#
# FROM must sit on the SENDING subdomain, never on matchatonoki.com itself:
# Cloudflare Email Routing owns the root's MX and SPF, and verifying the root
# in Resend would collide with it. TO is the routed address on the root, which
# Cloudflare forwards to Jaume's inbox. They look alike and do opposite things.
RESEND_API_KEY=""
REQUEST_NOTIFY_TO="request@matchatonoki.com"
REQUEST_NOTIFY_FROM="Matcha Tonoki <request@send.matchatonoki.com>"
